// Asclepios Sleep — data model
//
// Maps directly onto the handoff docs. Search comments for "Doc NN §x" to
// trace a field back to its source requirement.
//
// STAGING/PRODUCTION variant — Supabase Postgres. Every model below must
// stay byte-identical to schema.prisma (the SQLite dev schema); only this
// header + datasource block differ. `npm run check:schema-parity` (from
// apps/api) fails the build if the two drift apart. Do not add fields here
// that aren't also in schema.prisma, or vice versa.
//
// DATABASE_URL  = Supabase's pooled connection string (port 6543,
//                  ?pgbouncer=true) — used at runtime by the deployed app.
// DIRECT_URL    = Supabase's direct connection string (port 5432) — used
//                  only by `prisma migrate deploy`, which cannot run
//                  through the pooler. Both come from Supabase Project
//                  Settings -> Database -> Connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / Account — Supplement 07 §2-4, §8-9
// Account = identity. Membership / ProductOwnership / Entitlement = permission.
// Kept as separate models on purpose — never collapse them.
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  locale      String   @default("en") // en | zh-HK | zh-TW | zh-CN ...
  timezone    String   @default("Europe/London")
  role        String   @default("MEMBER") // MEMBER | ADMIN | THERAPIST
  isDemo      Boolean  @default(false)
  demoScenario String? // human label, staging only
  // Onboarding / personalisation — Design moodboard 28 Aug 2026. Chosen once
  // during setup (Home/Settings can change it later); wallpaperId picks a
  // seeded Wallpaper row, themeColor is an optional hex override of that
  // wallpaper's default themeColor (null = use the wallpaper's own colour).
  wallpaperId String?
  wallpaper   Wallpaper? @relation(fields: [wallpaperId], references: [id])
  themeColor  String?
  // Music library (29 Aug 2026) — Edmund's brief: "APP have original
  // musics and if use want to turn off or Change background music by
  // options". preferredSleepAudioId is one of packages/shared's
  // SYNTH_TRACKS codes (synthesized/original, no licensed asset needed —
  // same pattern as Wallpaper); null = app default (first SYNTH_TRACKS
  // entry). audioMuted lets a user turn the whole Sleep Player track off
  // without losing their chosen track for next time.
  preferredSleepAudioId String?
  audioMuted            Boolean  @default(false)
  createdAt   DateTime @default(now())

  authIdentities   AuthIdentity[]
  deviceSessions   DeviceSession[]
  consents         ConsentRecord[]
  memberships      Membership[]
  productOwnership ProductOwnership[]
  entitlements     Entitlement[]
  assessments      Assessment[]
  tagScores        TagScore[]
  coreProfiles     CoreProfileSnapshot[]
  reviewSnapshots  ReviewSnapshot[]
  sleepSessions    SleepSession[]
  routineStepLogs  RoutineStepLog[]
  productUsageLogs ProductUsageLog[]
  morningCheckins  MorningCheckin[]
  enrollments      ProgrammeEnrollment[]
  musicFavourites  MusicFavourite[]
  musicPlayHistory MusicPlayHistory[]
  analyticsEvents  AnalyticsEvent[]
  auditLogs        AuditLog[] @relation("ActorAuditLogs")
}

// Provider-independent auth (Supplement 07 §4). Never hard-code Apple/Google
// into the User model itself — this adapter table is where providers live.
model AuthIdentity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       String   // EMAIL_OTP | APPLE | GOOGLE | PASSWORD | WECHAT | SMS_OTP
  providerUserId String?  // e.g. Apple/Google subject id; null for EMAIL_OTP
  passwordHash   String?  // only set when provider = PASSWORD (optional, never primary)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
}

// One-time codes for Email OTP / Magic Link login (Supplement 07 §3).
model OtpChallenge {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
}

model DeviceSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  deviceLabel String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
}

// Terms / Privacy / Marketing / Research / Health-data notice — Supplement 07 §9
model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String   // TERMS_OF_USE | PRIVACY_POLICY | MARKETING_EMAIL | RESEARCH_ANALYTICS | HEALTH_DATA_NOTICE
  version    String
  accepted   Boolean
  acceptedAt DateTime @default(now())
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tier      String    // FREE | PREMIUM | DEMO
  startedAt DateTime  @default(now())
  expiresAt DateTime?
}

model ProductOwnership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  acquiredVia String  // ORDER | ADMIN_GRANT | DEMO_SEED | QR_ACTIVATION
  acquiredAt DateTime @default(now())
}

// Feature/content access — resolved by the Entitlement service, never
// inferred ad-hoc in a UI component (Doc 01 §5).
model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  key        String    // e.g. programme.28day | media.premium_audio | course.calm_mind
  grantedVia String    // ORDER | ADMIN_GRANT | DEMO_SEED | QR_ACTIVATION | SELF_ENROLL
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
}

// QR / Activation Code — Supplement 07 §7. Table + service kept, feature
// flag defaults OFF (see FeatureFlag seed). Do not delete this model when
// the flag is off; that is the point of keeping it.
model QrBatch {
  id           String   @id @default(cuid())
  label        String
  channel      String?
  distributor  String?
  createdAt    DateTime @default(now())

  codes ActivationCode[]
}

model ActivationCode {
  id              String    @id @default(cuid())
  code            String    @unique
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  batchId         String?
  batch           QrBatch?  @relation(fields: [batchId], references: [id])
  status          String    @default("UNUSED") // UNUSED | REDEEMED | REVOKED
  redeemedByUserId String?
  redeemedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Product / Content / Media — Doc 01 §5, §3 (all dynamic, never hard-coded)
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  category       String?
  imageUrl       String?
  priceCents     Int?
  currency       String?  @default("GBP")
  active         Boolean  @default(true)
  version        Int      @default(1)
  // Master Kick-off V1 §21 "product info must be dynamic": market and
  // lifecycle state added so Admin can vary availability/copy per market
  // and retire a SKU without deleting its history. Nullable/defaulted so
  // existing rows don't need a migration data-fix.
  market         String?  @default("UK") // ISO-ish market code: UK | RO | HK | ...
  lifecycleState String   @default("ACTIVE") // ACTIVE | COMING_SOON | DISCONTINUED
  createdAt      DateTime @default(now())

  ownerships      ProductOwnership[]
  activationCodes ActivationCode[]
  usageLogs       ProductUsageLog[]
  protocolSteps   ProductProtocolStep[]
}

// Requirement Recovery Matrix #14 — Product micro-protocols. Replaces the
// flat "use tonight's product" instruction with the real Apply→Breathe→Sleep
// (or Apply→Drink, per product) sequence from the printed catalog's usage
// panels. Admin-configurable: rows here are the whole protocol — no code
// change needed to add/reorder/retranslate a step (same "content changes
// need no deploy" rule as ContentItem). One row per (product, locale, order).
model ProductProtocolStep {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  locale      String   @default("en")
  stepOrder   Int
  title       String
  instruction String
  createdAt   DateTime @default(now())

  @@unique([productId, locale, stepOrder])
}

model ContentItem {
  id              String   @id @default(cuid())
  code            String   @unique
  type            String   // VIDEO | AUDIO_LESSON | ARTICLE
  title           String
  locale          String   @default("en")
  url             String?
  durationSeconds Int?
  tagsJson        String?  // JSON-encoded Tag[] this content is relevant to
  triggerJson     String?  // JSON-encoded trigger condition (Doc 03 §7)
  // Master Kick-off V1 "3 content layers": PUBLIC (open education) |
  // PRODUCT_LOCKED (unlocked by owning a specific product) | PAID_PROGRAMME
  // (unlocked by the 28-day programme entitlement). Entitlement resolution
  // for PRODUCT_LOCKED/PAID_PROGRAMME stays centralized in entitlement.ts —
  // never checked ad hoc in a route or component.
  layer           String   @default("PUBLIC")
  active          Boolean  @default(true)
  // Requirement Recovery Matrix #22 — Sleep Answer Library's 4-category
  // taxonomy (UNDERSTAND/LEARN/USE/EXPLORE). Nullable: non-library items
  // (e.g. CONTENT_SAFETY_DISCLAIMER) don't belong to any category.
  category        String?
  // Inline article body for type=ARTICLE items with no real external `url`
  // yet (same "no licensed asset, so build the honest thing" pattern as
  // the Wallpaper/Sleep-Audio work) — rendered as plain text in the app.
  bodyMarkdown    String?
}

// Pre-Recovery-Matrix placeholder (never wired to any picker UI or the
// player — see MusicTrack below, superseded 29 Aug 2026). Left as-is
// rather than deleted: still seeded, harmless, and deleting a model is a
// bigger risk than an unused table.
model AudioTrack {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  category        String   // ELECTRONIC | CLASSICAL | WATER | BOWL | NOISE | ...
  url             String?
  durationSeconds Int?
  isPremium       Boolean  @default(false)
  active          Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Music Library V1 (29 Aug 2026) — Edmund's brief: a real DB-backed music
// catalog, independent of Wallpaper (never hard-link one wallpaper to one
// track), with room to grow from today's 9 synthesized tracks to 50-100
// Asclepios-owned/licensed tracks, plus a future third-party provider
// layer. This is Phase 1 (database/schema) of Edmund's own stated build
// order — storage integration, admin/import tooling, the real player and
// Music Library UI, and the third-party provider adapter are deliberately
// NOT part of this pass; Tonight/SleepPlayer keep using SYNTH_TRACKS
// unchanged for now, so nothing live breaks. MusicTrack below is the
// target shape those later phases build against.
//
// sourceType:
//   ASCLEPIOS_ORIGINAL — commissioned/owned real audio file (audioUrl set)
//   ASCLEPIOS_LICENSED — properly licensed real audio file (audioUrl set)
//   THIRD_PARTY_API     — resolved live via a provider adapter (providerCode
//                         + providerId set; audioUrl may be a short-lived
//                         signed URL rather than a permanent one)
//   SYNTHESIZED         — no audio file at all; synthEngine names one of
//                         apps/web/src/audio/synthEngine.ts's engines,
//                         rendered live with Web Audio (today's 9 tracks —
//                         see the demo seed below). Kept as its own type
//                         rather than folded into ASCLEPIOS_ORIGINAL: it's
//                         algorithmically generated ambience, not a real
//                         recorded/commissioned asset, and Edmund was
//                         explicit that demo/placeholder audio must never
//                         be presented as a finished original track.
//
// primaryCategory / subcategory: Edmund's own simplified 2-level taxonomy
// (see packages/shared MUSIC_PRIMARY_CATEGORIES/MUSIC_SUBCATEGORIES) — 4
// primary groups (Sleep Sounds, Music, Sound Healing, Meditation) with
// several subcategories each, rather than surfacing ~20 flat categories to
// the user at once. moodTags/instrumentTags/sleepUseTags are comma-
// separated free text for V1 (simplest thing that works while the content
// library is still tiny) — upgradeable to real tag tables later without
// touching any other model.
model MusicTrack {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  artist          String?
  sourceType      String   // ASCLEPIOS_ORIGINAL | ASCLEPIOS_LICENSED | THIRD_PARTY_API | SYNTHESIZED
  audioUrl        String?  // null only for SYNTHESIZED
  synthEngine     String?  // one of synthEngine.ts's SynthEngineType values — SYNTHESIZED only
  artworkUrl      String?
  durationSeconds Int?     // null = open-ended (SYNTHESIZED loops until timer/manual stop)
  primaryCategory String   // SLEEP_SOUNDS | MUSIC | SOUND_HEALING | MEDITATION
  subcategory     String?  // see packages/shared MUSIC_SUBCATEGORIES for the controlled list per primaryCategory
  moodTags        String?  // comma-separated, V1 simplification — see comment above
  instrumentTags  String?  // comma-separated
  frequencyHz     Int?     // Frequency Collection tracks only (432/528/639/741/852/963)
  sleepUseTags    String?  // comma-separated
  premium         Boolean  @default(false)
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
  locale          String?  // null = locale-agnostic (most instrumental/ambient tracks)
  providerCode    String?  // THIRD_PARTY_API only — which MusicProvider adapter
  providerId      String?  // THIRD_PARTY_API only — the provider's own track id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  favourites  MusicFavourite[]
  playHistory MusicPlayHistory[]
}

model MusicFavourite {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  trackId   String
  track     MusicTrack @relation(fields: [trackId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([userId, trackId])
}

// One row per play (not just a "last played" pointer) so "Recently Played"
// can show a real recency-ordered list per Edmund's §3 UI brief, not just
// a single most-recent track.
model MusicPlayHistory {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  trackId  String
  track    MusicTrack @relation(fields: [trackId], references: [id])
  playedAt DateTime   @default(now())
}

model Wallpaper {
  id         String  @id @default(cuid())
  code       String  @unique
  title      String
  // Master Kick-off V1 Phase 3/26 added SUNRISE, MIST_MOUNTAINS and
  // STARRY_SKY on top of the original set. Centralized in
  // packages/shared WALLPAPER_CATEGORIES — never hard-code this list twice.
  category   String  // NATURE | NIGHT | WATER | MINIMAL | ABSTRACT | BRITISH_COUNTRYSIDE | JAPANESE_CALM | SUNRISE | MIST_MOUNTAINS | STARRY_SKY | WARM_COZY
  imageUrl   String?
  themeColor String?
  active     Boolean @default(true)

  users User[]
}

// ---------------------------------------------------------------------------
// Question / Decision engine — Doc 02
// ---------------------------------------------------------------------------

model Question {
  id               String   @id @default(cuid())
  code             String   // question_id, e.g. Q_RACING_003
  version          Int      @default(1)
  locale           String   @default("en")
  text             String
  type             String   // SINGLE_SELECT | MULTI_SELECT | FREE_TEXT
  triggerCondition String?  // JSON: e.g. { tag: "RACING_THOUGHTS", gte: 3 }
  safetyFlag       Boolean  @default(false)
  activeFrom       DateTime @default(now())
  activeTo         DateTime?

  answerOptions AnswerOption[]
  answers       AssessmentAnswer[]

  @@unique([code, version])
}

model AnswerOption {
  id           String  @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id])
  code         String   // e.g. A_RACING
  label        String
  tagEffectsJson String // JSON: [{ tag: "RACING_THOUGHTS", delta: 3 }]
  nextRuleCode String?  // points at DecisionRule.code

  answers AssessmentAnswer[]
}

// Generic, versioned, admin-editable rule used by the Adherence / Response /
// Strategy engines for thresholds — Doc 02 §5 ("formula/threshold must be
// versioned and admin-editable").
model DecisionRule {
  id             String   @id @default(cuid())
  code           String
  version        Int      @default(1)
  description    String?
  conditionJson  String   // JSON predicate
  actionJson     String   // JSON: { actionCode: "REMIND", ... }
  effectiveFrom  DateTime @default(now())
  effectiveTo    DateTime?

  @@unique([code, version])
}

model Assessment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // INITIAL | TWENTY_EIGHT_DAY_REASSESSMENT
  startedAt   DateTime @default(now())
  completedAt DateTime?

  answers AssessmentAnswer[]
}

model AssessmentAnswer {
  id             String   @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  questionId     String
  question       Question @relation(fields: [questionId], references: [id])
  answerOptionId String?
  answerOption   AnswerOption? @relation(fields: [answerOptionId], references: [id])
  freeText       String?  // only populated when AI Gateway is ON and question allows it
  answeredAt     DateTime @default(now())
}

// Doc 02 §5 / Doc 03 §2 — Core Profile (7/28-day) vs Current State (daily)
// live in the same TagScore shape, distinguished by `source`.
model TagScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tag        String
  severity   Int      @default(0) // 0-10
  frequency  Int      @default(0) // 0-5
  duration   Int      @default(0) // 0-5
  impact     Int      @default(0) // 0-5
  confidence Float    @default(1) // 0-1
  trend      String   @default("STABLE") // IMPROVING | STABLE | WORSENING
  source     String   // CORE_PROFILE | CURRENT_STATE
  decisionVersion String @default("v1")
  updatedAt  DateTime @updatedAt

  @@index([userId, tag, source])
}

model CoreProfileSnapshot {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  snapshotAt      DateTime @default(now())
  dataJson        String   // frozen copy of TagScore[source=CORE_PROFILE] at snapshot time
  decisionVersion String   @default("v1")
}

// 7-day and 28-day review output — Doc 03 §8-9
model ReviewSnapshot {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String   // SEVEN_DAY | TWENTY_EIGHT_DAY
  periodStart     DateTime
  periodEnd       DateTime
  findingsJson    String   // adherence + response + trend detail
  actionCode      String   // one of ACTION_CODES
  decisionVersion String   @default("v1")
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Daily tracking — Doc 03 §1, Supplement 07 §10-16
// ---------------------------------------------------------------------------

model SleepSession {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id])
  windDownStart             DateTime
  targetSleepTime           DateTime?
  wakeTime                  DateTime?
  sleepAudioId              String?
  sleepAudioDurationMode    String   @default("FIXED") // FIXED | CUSTOM | UNTIL_WAKE | ALL_NIGHT
  sleepAudioDurationSeconds Int?
  sleepAudioFadeOutSeconds  Int      @default(120)
  wallpaperId               String?
  visualDurationMode        String   @default("30_MIN") // 15_MIN | 30_MIN | 60_MIN | UNTIL_AUDIO | ALL_NIGHT
  wakeAudioId               String?
  wakeStyle                 String   @default("NORMAL") // GENTLE | NORMAL | STRONG
  snoozeMinutes              Int     @default(10)
  backupNotificationEnabled Boolean  @default(true)
  timezone                  String   @default("Europe/London")
  status                    String   @default("ACTIVE") // ACTIVE | WOKEN | ENDED
  createdAt                 DateTime @default(now())

  routineStepLogs  RoutineStepLog[]
  productUsageLogs ProductUsageLog[]
  morningCheckin   MorningCheckin?
}

model RoutineStepLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  sessionId String?
  session   SleepSession? @relation(fields: [sessionId], references: [id])
  stepCode  String   // PRODUCT | STRETCH | BREATHING | MUSIC | OTHER (matches RoutineStepDef.category)
  status    String   // DONE | SKIPPED
  loggedAt  DateTime @default(now())
}

model ProductUsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  sessionId String?
  session   SleepSession? @relation(fields: [sessionId], references: [id])
  status    String   // DONE | SKIPPED
  loggedAt  DateTime @default(now())
}

model MorningCheckin {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  sessionId        String?  @unique
  session          SleepSession? @relation(fields: [sessionId], references: [id])
  sleepRating      Int      // 1-5
  nightWakingCount String   // "0" | "1" | "2" | "3+"
  morningEnergy    String   // POOR | AVERAGE | GOOD
  addDetailsJson   String?  // optional: sleepOnsetMinutes, nocturia, stress, mood, pain, nasal, caffeine, alcohol, digestive
  submittedAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Programme / Routine definitions
// ---------------------------------------------------------------------------

model Programme {
  id                 String  @id @default(cuid())
  code               String  @unique
  name               String
  lengthDays         Int     @default(28)
  reviewFrequencyDays Int    @default(7) // kept independent of programme length (Doc 03 §8)
  active             Boolean @default(true)
  version            Int     @default(1)

  enrollments ProgrammeEnrollment[]
}

model ProgrammeEnrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  startedAt   DateTime  @default(now())
  currentDay  Int       @default(1)
}

model RoutineStepDef {
  id           String  @id @default(cuid())
  code         String  @unique
  label        String
  category     String  // PRODUCT | STRETCH | BREATHING | MUSIC | OTHER
  defaultOrder Int     @default(0)
  active       Boolean @default(true)
}

// ---------------------------------------------------------------------------
// Platform — flags, audit, analytics
// ---------------------------------------------------------------------------

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Append-only. Never update/delete rows here — write a new row instead.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  eventName String
  propsJson String?
  createdAt DateTime @default(now())
}
