 "rows": [
  {
   "cue": 1,
   "start": 5.75,
   "end": 7.85,
   "text": "大家好，歡迎嚟到阿斯康",
   "onset_ms": 60,
   "voiced_share": 0.87,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 2,
   "start": 8.25,
   "end": 15.14,
   "text": "今日同大家分享，點解講抗衰老除咗食啲乜，幾時食都咁值得留意",
   "onset_ms": 67,
   "voiced_share": 0.72,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 3,
   "start": 15.71,
   "end": 21.58,
   "text": "試諗吓，你開始留意營養揀咗補充品，每日都記得食",
   "onset_ms": 80,
   "voiced_share": 0.63,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 4,
   "start": 22.13,
   "end": 26.89,
   "text": "但忙起上嚟，食飯時間成日變午餐又推遲咗",
   "onset_ms": 54,
   "voiced_share": 0.74,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 5,
   "start": 27.49,
   "end": 31.76,
   "text": "夜晚再睇多一陣手機不知不覺，又夜咗瞓",
   "onset_ms": 80,
   "voiced_share": 0.66,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 6,
   "start": 32.31,
   "end": 34.66,
   "text": "咁樣，補充咗就夠未？",
   "onset_ms": 78,
   "voiced_share": 0.64,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 7,
   "start": 35.52,
   "end": 40.18,
   "text": "要答呢個問題我哋先睇吓細胞呢座日夜運作嘅城市",
   "onset_ms": 80,
   "voiced_share": 0.83,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 8,
   "start": 40.82,
   "end": 46.02,
   "text": "線粒體，好似發電站幫細胞提供運作需要嘅能量",
   "onset_ms": 80,
   "voiced_share": 0.73,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 9,
   "start": 47.26,
   "end": 51.95,
   "text": "你每日行路、活動背後都有細胞嘅能量供應",
   "onset_ms": 80,
   "voiced_share": 0.68,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 10,
   "start": 52.53,
   "end": 54.96,
   "text": "呢座城市亦有回收站",
   "onset_ms": 80,
   "voiced_share": 0.63,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 11,
   "start": 55.21,
   "end": 59.77,
   "text": "溶酶體，會分解同回收部分受損嘅蛋白質同部件",
   "onset_ms": 80,
   "voiced_share": 0.8,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 12,
   "start": 61.13,
   "end": 62.79,
   "text": "仲有維修工作",
   "onset_ms": 80,
   "voiced_share": 0.67,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 13,
   "start": 62.86,
   "end": 68.79,
   "text": "例如遺傳物質嘅修復就係幫細胞維護遺傳物質嘅完整性",
   "onset_ms": 80,
   "voiced_share": 0.73,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 14,
   "start": 70.37,
   "end": 76.23,
   "text": "隨住年齡增長，部分能量清理同維護功能可能減弱",
   "onset_ms": 80,
   "voiced_share": 0.73,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 15,
   "start": 76.31,
   "end": 81.74,
   "text": "損傷日積月累，就可能影響細胞以至組織同器官嘅表現",
   "onset_ms": 80,
   "voiced_share": 0.76,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 16,
   "start": 83.3,
   "end": 86.05,
   "text": "但細胞嘅工作，原來仲有時間表",
   "onset_ms": 80,
   "voiced_share": 0.8,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 17,
   "start": 86.45,
   "end": 89.83,
   "text": "而朝早嘅光線，就係重要嘅時間訊號",
   "onset_ms": 56,
   "voiced_share": 0.77,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 18,
   "start": 90.49,
   "end": 96.64,
   "text": "光線會影響腦內嘅主時鐘再協調唔同器官同細胞嘅時鐘",
   "onset_ms": 80,
   "voiced_share": 0.75,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 19,
   "start": 96.64,
   "end": 100.84,
   "text": "代謝同部分維護工作都受到日夜節律調節",
   "onset_ms": 80,
   "voiced_share": 0.71,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 20,
   "start": 101.38,
   "end": 105.35,
   "text": "節律同細胞功能亦會隨住衰老互相影響",
   "onset_ms": 80,
   "voiced_share": 0.82,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 21,
   "start": 108.09,
   "end": 111.39,
   "text": "所以，睡眠同節律值得一齊照顧",
   "onset_ms": 80,
   "voiced_share": 0.65,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 22,
   "start": 111.67,
   "end": 116.69,
   "text": "但修復唔係只喺夜晚發生唔同工作，有各自嘅節奏",
   "onset_ms": 80,
   "voiced_share": 0.71,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 23,
   "start": 117.34,
   "end": 121.89,
   "text": "進餐時間亦會影響部分外周時鐘同代謝節律",
   "onset_ms": 80,
   "voiced_share": 0.76,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 24,
   "start": 121.97,
   "end": 126.2,
   "text": "食乜，同幾時食係兩個值得一齊理解嘅問題",
   "onset_ms": 80,
   "voiced_share": 0.65,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 25,
   "start": 128.75,
   "end": 133.26,
   "text": "研究一種成分好似研究點樣改善一個發電站",
   "onset_ms": 80,
   "voiced_share": 0.69,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 26,
   "start": 133.45,
   "end": 137.02,
   "text": "但要照顧成座城市，就要再睇埋整體",
   "onset_ms": 80,
   "voiced_share": 0.76,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 27,
   "start": 137.57,
   "end": 143.75,
   "text": "營養同代謝提供原料同能量荷爾蒙傳遞調節訊息",
   "onset_ms": 56,
   "voiced_share": 0.71,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 28,
   "start": 144.13,
   "end": 146.9,
   "text": "免疫亦參與細胞環境嘅調節",
   "onset_ms": 80,
   "voiced_share": 0.77,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 29,
   "start": 147.13,
   "end": 150.97,
   "text": "細胞功能，同全身系統一直互相影響",
   "onset_ms": 80,
   "voiced_share": 0.74,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 30,
   "start": 152.16,
   "end": 157.37,
   "text": "呢個就係阿斯康嘅理念：系統性、節律性、實際應用",
   "onset_ms": 55,
   "voiced_share": 0.75,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 31,
   "start": 157.81,
   "end": 164.6,
   "text": "先建立飲食、活動同睡眠嘅基礎再按需要同證據，考慮營養支持",
   "onset_ms": 80,
   "voiced_share": 0.74,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 32,
   "start": 164.99,
   "end": 171.3,
   "text": "用乜、點用、幾時用，要逐項睇唔係每樽都硬分早午晚",
   "onset_ms": 80,
   "voiced_share": 0.69,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 33,
   "start": 172.1,
   "end": 177.9,
   "text": "跟住阿斯康，我哋會帶你由細胞嘅能量清理同修復出發",
   "onset_ms": 80,
   "voiced_share": 0.73,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 34,
   "start": 177.9,
   "end": 183.47,
   "text": "一齊探索身體機能同生命節律點樣變成每日做得到嘅選擇",
   "onset_ms": 80,
   "voiced_share": 0.78,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 35,
   "start": 183.99,
   "end": 187.4,
   "text": "呢段抗衰老旅程，由認識自己開始",
   "onset_ms": 80,
   "voiced_share": 0.83,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 36,
   "start": 187.98,
   "end": 190.28,
   "text": "今日先同大家分享到呢度",
   "onset_ms": 80,
   "voiced_share": 0.74,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 37,
   "start": 190.46,
   "end": 196.37,
   "text": "之後我哋會繼續推出更多短片由細胞、身體機能到日常生活",
   "onset_ms": 80,
   "voiced_share": 0.71,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 38,
   "start": 196.46,
   "end": 200.51,
   "text": "一步步同大家了解乜嘢先係真正嘅抗衰老",
   "onset_ms": 80,
   "voiced_share": 0.76,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 39,
   "start": 200.86,
   "end": 202.29,
   "text": "下次再同大家分享",
   "onset_ms": 80,
   "voiced_share": 0.76,
   "late_tail_s": 0.0,
   "pass": true
  },
