   "text": "一步步同大家了解乜嘢先係真正嘅抗衰老",
   "onset_ms": 80,
   "voiced_share": 0.81,
   "late_tail_s": 0.0,
   "pass": true
  },
  {
   "cue": 39,
   "start": 191.24,
   "end": 193.45,
   "text": "下次再同大家分享",
   "onset_ms": 80,
   "voiced_share": 0.78,
   "late_tail_s": 0.0,
   "pass": true
  },
